{
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.4" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.ico", "dest": "/assets/img/favicon.png" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
