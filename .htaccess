Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS en el servidor (no aplica en localhost)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Bloquear carpetas y archivos internos
  RewriteRule ^(app|config|database|storage|vendor|LOGO|IMG)(/|$) - [F,L]
  RewriteRule ^(composer\.(json|lock)|README\.md|\.env.*)$ - [F,L]
</IfModule>

<FilesMatch "\.(sql|md|lock|log|ini|sh)$">
  Require all denied
</FilesMatch>
